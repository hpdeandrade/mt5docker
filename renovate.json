{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": false,
  "dockerfile": {
    "managerFilePatterns": [
      "/Dockerfile/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/Dockerfile/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s+ARG .*?_VERSION=(?<currentValue>.*)\\s"
      ]
    }
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/compose.yaml/"
    ]
  },
  "commitMessagePrefix": "chore(deps): "
}
